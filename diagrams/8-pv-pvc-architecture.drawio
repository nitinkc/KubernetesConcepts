          <mxGeometry x="870" y="150" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="depFrontend" value="&lt;b&gt;frontend-deployment&lt;/b&gt; — Deployment, replicas: 6&lt;br&gt;image: nitinkc/k8s-frontend&lt;br&gt;env: BACKEND_URL=http://go-backend-service:80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="240" height="230" as="geometry"/>
