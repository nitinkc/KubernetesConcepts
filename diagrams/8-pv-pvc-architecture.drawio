        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="depRedis" target="pvc" value="volumes → persistentVolumeClaim&lt;br&gt;claimName: redis-claim">
