        </mxCell>
        <mxCell id="pvc" value="&lt;b&gt;PersistentVolumeClaim — redis-claim&lt;/b&gt;&lt;br&gt;requests: 1Gi storage • accessModes: ReadWriteOnce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="870" y="620" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pv" value="&lt;b&gt;PersistentVolume&lt;/b&gt;&lt;br&gt;(dynamically provisioned via StorageClass)&lt;br&gt;1Gi • survives pod restarts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="730" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;&amp;#9632;&lt;/font&gt; Service — &lt;b&gt;NodePort&lt;/b&gt;: reachable from outside the cluster via &amp;lt;node-ip&amp;gt;:&amp;lt;nodePort&amp;gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&amp;#9632;&lt;/font&gt; Service — &lt;b&gt;ClusterIP&lt;/b&gt;: internal-only virtual IP, no external access&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&amp;#9632;&lt;/font&gt; Frontend pods (app=frontend-ui) • &lt;font color=&quot;#10739e&quot;&gt;&amp;#9632;&lt;/font&gt; Backend pods (app=go-k8s-server) • &lt;font color=&quot;#b85450&quot;&gt;&amp;#9632;&lt;/font&gt; Redis pods (app=redis-db)&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&amp;#9632;&lt;/font&gt; PVC — claim for storage • &lt;font color=&quot;#666666&quot;&gt;&amp;#9632;&lt;/font&gt; PV — actual storage (persists beyond pod lifecycle)&lt;br&gt;&lt;br&gt;&lt;b&gt;Arrows:&lt;/b&gt; solid = Service routing via selector • dashed = in-cluster DNS call • dotted = storage binding" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="620" width="550" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="svcFrontend" value="&lt;b&gt;http://&amp;lt;node-ip&amp;gt;:30081&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry">
