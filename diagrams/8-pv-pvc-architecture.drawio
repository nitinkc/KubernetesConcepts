        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svcBackend" target="depBackend" value="selector: app=go-k8s-server&lt;br&gt;load-balances over pods :8080">
