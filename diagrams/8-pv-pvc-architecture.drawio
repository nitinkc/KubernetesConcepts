        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="svcBackend" value="&lt;b&gt;http://&amp;lt;node-ip&amp;gt;:30080&lt;/b&gt; (direct backend access)">
          <mxGeometry relative="1" as="geometry">
